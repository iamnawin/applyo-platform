# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FreeLLMAPI (primary AI provider — self-hosted OpenAI-compatible proxy)
AI_PROVIDER=freellmapi
AI_BASE_URL=http://localhost:3001/v1
AI_API_KEY=freellmapi-your-unified-key
AI_DEFAULT_MODEL=auto
AI_TIMEOUT_MS=30000
AI_ENABLE_FREE_ROUTER=true

# Google Gemini (used for embeddings; fallback for text)
GOOGLE_AI_API_KEY=your-gemini-api-key

# OpenAI (optional fallback for text tasks)
OPENAI_API_KEY=sk-...

# Groq (optional fallback for text tasks)
GROQ_API_KEY=gsk_...

# AI Provider Order (freellmapi is primary, others are fallback)
AI_TEXT_PROVIDER_ORDER=freellmapi,gemini,openai,groq
AI_EMBEDDING_PROVIDER_ORDER=gemini

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Job Discovery (Serper.dev)
SERPER_API_KEY=your-serper-key

# Email (Resend)
RESEND_API_KEY=re_...

# Cron job auth (Vercel Cron uses this to authenticate scheduled requests)
CRON_SECRET=your-random-secret-here

# Automation (Remote Browser via Browserbase/browserless.io)
# Format: wss://connect.browserbase.com?apiKey=YOUR_API_KEY
BROWSER_WS_ENDPOINT=

# Firecrawl (web scraping for job boards)
FIRECRAWL_API_KEY=fc-...

# Apify (pre-built job board scrapers for Naukri, LinkedIn, Indeed)
APIFY_API_TOKEN=apify_api_...
